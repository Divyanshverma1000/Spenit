{
  // Spenit API as a Cloudflare Worker. Deploy: `npm run cf:deploy`. Guide: ../DEPLOYMENT.md
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spenit-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },

  // Packages that don't apply on Workers are swapped for tiny stubs at bundle time.
  // Migrations are bundled as text and applied by the Worker (src/db/workerMigrations.ts).
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],

  "alias": {
    "compression": "./src/worker-stubs/compression.ts",
    "dotenv": "./src/worker-stubs/dotenv.ts",
    "ioredis": "./src/worker-stubs/ioredis.ts",
    "iconv-lite": "./src/worker-stubs/iconv-lite.ts"
  },

  // Non-secret settings. Secrets (JWT, VAPID private key, ...) are set with `wrangler secret put`.
  "vars": {
    "NODE_ENV": "production",
    "FRONTEND_URL": "https://spenit.vercel.app",
    "GOOGLE_CLIENT_ID": "762976241231-a2ohr923e9nmhrbuks7no7avhuufr25p.apps.googleusercontent.com",
    "GROQ_MODEL": "openai/gpt-oss-120b",
    "GROQ_VISION_MODEL": "qwen/qwen3.8-27b"
  },

  // Every 4 hours: a real database query (keeps a free Supabase project from being paused for
  // inactivity) plus tidying old idempotency keys. Check it with `npm run cf:tail`.
  "triggers": { "crons": ["17 */4 * * *"] },

  // Rate limits shared by every Worker instance (src/app.ts). Per minute; keys are the
  // client address, or the account for writes and AI.
  "ratelimits": [
    { "name": "RL_GLOBAL", "namespace_id": "1001", "simple": { "limit": 600, "period": 60 } },
    { "name": "RL_AUTH", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
    { "name": "RL_AI", "namespace_id": "1003", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_WRITE", "namespace_id": "1004", "simple": { "limit": 120, "period": 60 } },
    { "name": "RL_PUBLIC", "namespace_id": "1005", "simple": { "limit": 60, "period": 60 } }
  ],

  // Filled in by `npm run cf:connect-db` once your Postgres exists.
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "5677d5163b894bc597b9404eb4bc62d7" }]
}
