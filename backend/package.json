{
  "name": "spenit-backend",
  "version": "0.1.0",
  "description": "Spenit backend â€” Node.js + Express + TypeScript",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "migrate": "ts-node --transpile-only src/db/migrate.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "migrate:prod": "node dist/db/migrate.js",
    "gen:secrets": "node scripts/generate-secrets.js",
    "start:prod": "npm run migrate:prod && npm start",
    "cf:dev": "node scripts/cf-dev.js",
    "cf:deploy": "wrangler deploy",
    "cf:connect-db": "node scripts/cf-connect-db.js",
    "cf:tail": "wrangler tail --format pretty",
    "test:frontend": "vitest run --root ../frontend lib"
  },
  "vitest": {
    "include": [
      "src/**/*.test.ts"
    ]
  },
  "dependencies": {
    "@types/web-push": "^3.6.4",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.7.1",
    "groq-sdk": "^1.4.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.3.2",
    "jose": "^6.2.15",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.12.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.11.6",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.157.0"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "qs": "^6.17.1"
  }
}
