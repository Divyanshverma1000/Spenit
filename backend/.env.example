# Backend environment variables.
# Local:      copy this file to .env and fill it in. Never commit .env.
# Production: set the same names in Render's dashboard (see ../DEPLOYMENT.md).

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
# development | production. In production the API refuses to start with an invalid config.
NODE_ENV=development

# Browser origins allowed to call the API (CORS). Comma-separated for several.
# Production example: https://spenit.vercel.app
FRONTEND_URL=http://localhost:3000

# ── Database (Postgres) ───────────────────────────────────────────────────────
DATABASE_URL=postgresql://spenit:spenit@localhost:5432/spenit
# true for hosted Postgres (Supabase, Neon, ...) which requires TLS. false for local Docker.
DATABASE_SSL=false
# Free hosted databases allow few connections. Default is 8.
# DATABASE_POOL_MAX=8

# ── Cache (optional) ──────────────────────────────────────────────────────────
# Leave EMPTY to use the built-in in-memory cache: right for a single instance and it has
# no quota. Set an Upstash/Redis URL (rediss://...) only if you run several instances.
REDIS_URL=

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate all secrets at once:  npm run gen:secrets
# Two DIFFERENT random strings, at least 32 characters each.
JWT_ACCESS_SECRET=replace_with_a_strong_random_secret_at_least_64_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_strong_random_secret_at_least_64_chars
JWT_REFRESH_EXPIRES_IN=7d

# ── Google sign-in ────────────────────────────────────────────────────────────
# OAuth Web client ID from https://console.cloud.google.com/apis/credentials
# (Authorized JavaScript origins must include your frontend URL.)
GOOGLE_CLIENT_ID=your_google_oauth_client_id

# ── Web push (optional) ───────────────────────────────────────────────────────
# `npm run gen:secrets` prints a matching pair. The PUBLIC key must also be set on the frontend.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_MAILTO=mailto:you@example.com

# ── AI assistant (optional) ───────────────────────────────────────────────────
# Server-wide fallback key, used for order imports when a user has not added their own Groq
# key in Profile. On Cloudflare set it with: npx wrangler secret put GROQ_API_KEY
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# qwen3.6-27b was retired by Groq on 2026-09-14
GROQ_VISION_MODEL=qwen/qwen3.8-27b
