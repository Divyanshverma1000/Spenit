# Backend Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000

# URL of the frontend (used for CORS allow-list)
FRONTEND_URL=http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://spenit:spenit@localhost:5432/spenit

# ── Cache ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT Auth (Architecture.md §10) ───────────────────────────────────────────
# Short-lived access token secret (15 min default).
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_strong_random_secret_at_least_64_chars
JWT_ACCESS_EXPIRES_IN=15m

# Long-lived refresh token secret — must be DIFFERENT from JWT_ACCESS_SECRET.
# Stored as an httpOnly cookie; never in localStorage (Architecture.md §10).
JWT_REFRESH_SECRET=replace_with_a_different_strong_random_secret_at_least_64_chars
JWT_REFRESH_EXPIRES_IN=7d

# ── Google OAuth (Stage 1) ────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized JS origins (local dev): http://localhost:3000
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
