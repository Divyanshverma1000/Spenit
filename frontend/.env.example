# Frontend environment variables.
# Local:      copy this file to .env.local and fill it in. Never commit .env.local.
# Production: set these in Vercel → Project → Settings → Environment Variables (see ../DEPLOYMENT.md).

# ── Backend API ───────────────────────────────────────────────────────────────
# Local development: the backend started with `npm run dev` in /backend.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Production on Vercel: do NOT set NEXT_PUBLIC_API_URL (it then defaults to "/api").
# Instead set BACKEND_URL (server-side only) to your deployed API, and Next.js proxies
# /api/* to it. No CORS and the sign-in cookie stays first-party.
# BACKEND_URL=https://spenit-api.divyanshverma0428.workers.dev

# ── Google sign-in ────────────────────────────────────────────────────────────
# OAuth Web client ID from https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins: http://localhost:3000 and your Vercel URL.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_oauth_client_id

# ── Web push (optional) ───────────────────────────────────────────────────────
# Must match VAPID_PUBLIC_KEY in the backend exactly. `npm run gen:secrets` in /backend prints a pair.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
